# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# Bun loads `.env` automatically — no dotenv needed. On a hosting platform
# (Render, Railway, Fly) set these in the dashboard instead and skip PORT,
# which the platform injects itself.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance. Prisma connects through the `pg` driver adapter,
# so a pooled connection string (Prisma Postgres, Supabase pooler, Neon,
# PgBouncer) is preferred over a direct one.
DATABASE_URL="postgres://user:password@host:5432/assignmate?sslmode=verify-full"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Holds registration/reset OTPs (5 min TTL) and the cached bKash grant token.
# One URL for every environment — point it at localhost locally, at the hosted
# instance in production.
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use two different long random strings. Generate one with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cost factor for password hashing. 12 is a sane default; raising it makes
# login slower for everyone, including attackers.
BCRYPT_SALT_ROUNDS=12

# Password given to the accounts created by the seed script. Set this to
# something real before seeding anything that is reachable from the internet —
# the seed creates an ADMIN account.
DEFAULT_PASSWORD="change-me-before-seeding"

# ── URLs ──────────────────────────────────────────────────────────────────────
# FRONTEND_URL is used for CORS and for links inside outgoing emails.
# APP_BASE_URL is this API's own public origin — bKash redirects back to it,
# so it must be reachable from the internet (use a tunnel during local
# gateway testing).
BACKEND_URL="http://localhost:4000"
APP_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From console.cloud.google.com → APIs & Services → Credentials.
# The redirect URL must match the one registered there, character for character.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URL="http://localhost:3000/auth/google/callback"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Stores assignment attachments, expert verification documents and submissions.
# Uploads stream straight from memory, so nothing touches local disk.
CLOUDINARY_NAME="your-cloud-name"
CLOUDINARY_KEY="your-api-key"
CLOUDINARY_SECRET="your-api-secret"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_EMAIL must be an address on a domain you have verified with Resend,
# otherwise every send is rejected.
RESEND_API="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_EMAIL="noreply@yourdomain.com"
EMAIL_FROM_NAME="AssignMate"
SUPPORT_EMAIL="support@yourdomain.com"

# ── bKash (payment gateway) ───────────────────────────────────────────────────
# Sandbox credentials come from the bKash merchant portal. The sandbox base URL
# below is safe to commit; swap it for the live one only with live credentials.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="sandbox-username"
BKASH_PASSWORD="sandbox-password"
BKASH_APP_KEY="sandbox-app-key"
BKASH_APP_SECRET="sandbox-app-secret"
