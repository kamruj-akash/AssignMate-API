model AssignmentBid {
  id String @id @default(uuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  expertId String
  expert   Expert @relation(fields: [expertId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  proposedAmount    Decimal  @db.Decimal(12, 2)
  estimatedDelivery DateTime
  coverNote         String

  wonAssignment Assignment? @relation("AcceptedBid")

  status       BidStatus @default(PENDING)
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([assignmentId, expertId])
  @@map("assignmentBids")
}
