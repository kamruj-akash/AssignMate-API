model Payment {
  id String @id @default(uuid())

  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  transactionId String?       @unique //gateway tx id
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(INITIATED)

  paymentGateway        PaymentGateway @default(BKASH)
  // bkash
  merchantInvoiceNumber String?        @unique // assignment id
  bkashPaymentId        String?        @unique
  bkashTrxId            String?        @unique
  payerReference        String? //users email or phoneNo
  paidAt                String?
  gatewayResponse       Json?

  // others payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
