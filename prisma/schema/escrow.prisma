model Escrow {
  id                 String       @id @default(uuid())
  assignmentId       String       @unique
  assignment         Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  totalAmount        Decimal      @db.Decimal(12, 2)
  
  platformCommission Decimal      @default(15) @db.Decimal(12, 2)
  expertEarnings     Decimal      @default(85) @db.Decimal(12, 2)
  status             EscrowStatus @default(HELD)
  disbursedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("escrows")
}
