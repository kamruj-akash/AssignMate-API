model Assignment {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  title         String
  description   String
  attachmentUrl Json?
  budget        Decimal          @db.Decimal(12, 2)
  deadline      DateTime
  status        AssignmentStatus @default(OPEN)

  assignedExpertId String?
  assignedExpert   Expert? @relation(fields: [assignedExpertId], references: [id])
  submissionUrl    Json?
  disputedReason   String?

  bids AssignmentBid[]

  acceptedBidId String?        @unique
  acceptedBid   AssignmentBid? @relation("AcceptedBid", fields: [acceptedBidId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment   Payment?
  review    Review?
  escrow Escrow?

  @@index([studentId, title, budget])
  @@map("assignments")
}
